<?xml version="1.0"?>
<sdf version="1.9">
  <world name="integration_demo">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <physics name="demo_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <direction>-0.4 0.3 -1</direction>
    </light>
    <model name="arena">
      <static>true</static>
      <link name="arena_geometry">
        <collision name="floor">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>8 8 0.1</size></box></geometry>
        </collision>
        <visual name="floor_visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>8 8 0.1</size></box></geometry>
        </visual>
        <collision name="front_wall">
          <pose>1.8 0 0.35 0 0 0</pose>
          <geometry><box><size>0.15 1.4 0.7</size></box></geometry>
        </collision>
        <visual name="front_wall_visual">
          <pose>1.8 0 0.35 0 0 0</pose>
          <geometry><box><size>0.15 1.4 0.7</size></box></geometry>
        </visual>
        <collision name="left_box">
          <pose>0.25 1.1 0.25 0 0 0</pose>
          <geometry><box><size>0.45 0.45 0.5</size></box></geometry>
        </collision>
        <visual name="left_box_visual">
          <pose>0.25 1.1 0.25 0 0 0</pose>
          <geometry><box><size>0.45 0.45 0.5</size></box></geometry>
        </visual>
        <collision name="right_box">
          <pose>0.8 -1.1 0.25 0 0 0</pose>
          <geometry><box><size>0.4 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="right_box_visual">
          <pose>0.8 -1.1 0.25 0 0 0</pose>
          <geometry><box><size>0.4 0.5 0.5</size></box></geometry>
        </visual>
        <collision name="east_boundary">
          <pose>3.95 0 0.30 0 0 0</pose>
          <geometry><box><size>0.10 8 0.60</size></box></geometry>
        </collision>
        <visual name="east_boundary_visual">
          <pose>3.95 0 0.30 0 0 0</pose>
          <geometry><box><size>0.10 8 0.60</size></box></geometry>
        </visual>
        <collision name="west_boundary">
          <pose>-3.95 0 0.30 0 0 0</pose>
          <geometry><box><size>0.10 8 0.60</size></box></geometry>
        </collision>
        <visual name="west_boundary_visual">
          <pose>-3.95 0 0.30 0 0 0</pose>
          <geometry><box><size>0.10 8 0.60</size></box></geometry>
        </visual>
        <collision name="north_boundary">
          <pose>0 3.95 0.30 0 0 0</pose>
          <geometry><box><size>7.80 0.10 0.60</size></box></geometry>
        </collision>
        <visual name="north_boundary_visual">
          <pose>0 3.95 0.30 0 0 0</pose>
          <geometry><box><size>7.80 0.10 0.60</size></box></geometry>
        </visual>
        <collision name="south_boundary">
          <pose>0 -3.95 0.30 0 0 0</pose>
          <geometry><box><size>7.80 0.10 0.60</size></box></geometry>
        </collision>
        <visual name="south_boundary_visual">
          <pose>0 -3.95 0.30 0 0 0</pose>
          <geometry><box><size>7.80 0.10 0.60</size></box></geometry>
        </visual>
        <sensor name="obstacle_contacts" type="contact">
          <contact>
            <collision>front_wall</collision>
            <collision>left_box</collision>
            <collision>right_box</collision>
            <collision>east_boundary</collision>
            <collision>west_boundary</collision>
            <collision>north_boundary</collision>
            <collision>south_boundary</collision>
            <topic>/demo/contacts</topic>
          </contact>
        </sensor>
      </link>
    </model>
    <model name="demo_robot">
      <pose>0 0 0.105 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.2</mass>
          <inertia><ixx>0.007</ixx><iyy>0.010</iyy><izz>0.015</izz></inertia>
        </inertial>
        <collision name="chassis">
          <geometry><box><size>0.30 0.23 0.09</size></box></geometry>
        </collision>
        <visual name="chassis_visual">
          <geometry><box><size>0.30 0.23 0.09</size></box></geometry>
          <material><ambient>0.12 0.55 0.72 1</ambient><diffuse>0.12 0.55 0.72 1</diffuse></material>
        </visual>
        <!-- A low-friction sphere supports the rear of the two-wheel base. -->
        <collision name="rear_support">
          <pose>-0.11 0 -0.073 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.11 0 0 0</pose>
          <topic>/demo/scan</topic>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples><resolution>1</resolution>
                <min_angle>-3.141592654</min_angle><max_angle>3.141592654</max_angle>
              </horizontal>
            </scan>
            <range><min>0.10</min><max>6.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>
      <link name="left_wheel">
        <pose>0.035 0.14 -0.045 1.570796327 0 0</pose>
        <inertial>
          <mass>0.10</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.00018</izz></inertia>
        </inertial>
        <collision name="wheel"><geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry></collision>
        <visual name="wheel_visual"><geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry></visual>
      </link>
      <link name="right_wheel">
        <pose>0.035 -0.14 -0.045 1.570796327 0 0</pose>
        <inertial>
          <mass>0.10</mass>
          <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.00018</izz></inertia>
        </inertial>
        <collision name="wheel"><geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry></collision>
        <visual name="wheel_visual"><geometry><cylinder><radius>0.06</radius><length>0.035</length></cylinder></geometry></visual>
      </link>
      <joint name="left_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <joint name="right_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_joint</left_joint><right_joint>right_joint</right_joint>
        <wheel_separation>0.28</wheel_separation><wheel_radius>0.06</wheel_radius>
        <topic>/demo/cmd_vel</topic><odom_topic>/demo/wheel_odom</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
      </plugin>
      <!-- Publish the simulator pose and motion in the same frame as the arena. -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/demo/odom</odom_topic>
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </model>
  </world>
</sdf>
